# Copy to .env at the repo root. apps/api loads it via python-dotenv.
ANTHROPIC_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=apppilot

# Models: every agent defaults to APPPILOT_MODEL; override per role with
# APPPILOT_SUPERVISOR_MODEL / APPPILOT_EXPLORER_MODEL / APPPILOT_VERIFIER_MODEL / APPPILOT_TEST_WRITER_MODEL
APPPILOT_MODEL=claude-opus-5-5
APPPILOT_SUPERVISOR_EFFORT=high
APPPILOT_WORKER_EFFORT=medium

# Target app and storage
APP_URL=http://localhost:3001
DATA_DIR=./data
APPPILOT_HEADLESS=true
